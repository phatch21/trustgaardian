# Skip dependency install scripts, so a fresh clone installs without a C++
# toolchain.
#
# npm's arborist adds an implicit `node-gyp rebuild` install script to any
# package that has a binding.gyp and no install/preinstall script, unless the
# package declares `gypfile: false`. better-sqlite3 declares it and ships
# prebuilt binaries for every supported platform, but lockfile entries do not
# carry `gypfile`, so a lockfile-driven install (npm install on a fresh clone,
# npm ci) loses the opt-out and compiles from source anyway. Without VC++
# build tools, as on a stock Windows machine, that fails in node-gyp.
#
# No dependency here needs an install script. `npm test` and `npm run <name>`
# still run their script; only pre/post hooks are skipped, and there are none.
# See docs/friction.md.
ignore-scripts=true
